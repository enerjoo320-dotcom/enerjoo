{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Solar energy system components (panels, inverters, batteries) from suppliers.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "English name of the product" },
        "nameAr": { "type": "string", "description": "Arabic name of the product" },
        "type": { "type": "string", "description": "Type of product (panel, inverter, battery)" },
        "supplierId": { "type": "string", "description": "Reference to the supplier user document" },
        "price": { "type": "number", "description": "Price in Egyptian Pounds" },
        "specifications": { "type": "object", "description": "Product-specific tech specs" },
        "updatedAt": { "type": "object", "format": "timestamp", "description": "Server timestamp of last update" }
      },
      "required": ["name", "nameAr", "type", "price", "supplierId"]
    },
    "User": {
      "title": "User",
      "description": "User profiles representing customers, suppliers, and admins.",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "English full name" },
        "nameAr": { "type": "string", "description": "Arabic full name" },
        "type": { "type": "string", "enum": ["customer", "supplier", "admin"], "description": "User role" },
        "verified": { "type": "boolean", "description": "Whether the supplier is verified by admin" },
        "phone": { "type": "string", "description": "Contact or WhatsApp phone number" },
        "email": { "type": "string", "description": "User email address" },
        "location": { "type": "string", "description": "Supplier state or location" },
        "rating": { "type": "number", "description": "Supplier average rating" },
        "totalSales": { "type": "number", "description": "Total sales count of supplier" },
        "avatar": { "type": "string", "description": "User avatar icon URL" }
      },
      "required": ["name", "type"]
    },
    "Quotation": {
      "title": "Quotation",
      "description": "Quotation requests generated by the AI Solar Calculator for potential leads",
      "type": "object",
      "properties": {
        "customerName": { "type": "string", "description": "Full name of the customer" },
        "name": { "type": "string", "description": "Legacy/alias full name of the requester" },
        "customerEmail": { "type": "string", "description": "Email address of the customer" },
        "email": { "type": "string", "description": "Legacy/alias email address" },
        "phone": { "type": "string", "description": "Egyptian mobile phone number or WhatsApp" },
        "customerPhone": { "type": "string", "description": "Customer phone number" },
        "customerId": { "type": "string", "description": "Firebase Auth UID of customer if logged in" },
        "userId": { "type": "string", "description": "User ID" },
        "requestId": { "type": "string", "description": "Unique quotation reference ID" },
        "systemType": { "type": "string", "description": "Solar system type: on-grid, off-grid, hybrid, pump" },
        "systemTypeName": { "type": "string", "description": "Arabic/descriptive solar system type title" },
        "location": { "type": "string", "description": "Governorate/City selection or address" },
        "governorate": { "type": "string", "description": "Governorate" },
        "usage": { "type": "number", "description": "Monthly energy usage in kWh or description" },
        "monthlyBill": { "type": "number", "description": "Monthly electricity bill in EGP" },
        "batteryRequired": { "type": "boolean", "description": "Whether battery storage is required in system" },
        "systemSpecs": { "type": "string", "description": "Serialized specifications of system" },
        "targetTier": { "type": "string", "description": "Tier: budget, recommended, premium" },
        "priceEstimate": { "type": "number", "description": "Calculated total price estimate in EGP" },
        "notes": { "type": "string", "description": "Extra optional notes from requester" },
        "supplierContacted": { "type": "string", "description": "Name of supplier contacted" },
        "status": { "type": "string", "enum": ["pending", "in_progress", "contacted", "processed", "completed", "cancelled"], "description": "Status of the quotation request" },
        "createdAt": { "type": "object", "format": "timestamp", "description": "Server creation timestamp" },
        "updatedAt": { "type": "object", "format": "timestamp", "description": "Server update timestamp" }
      },
      "required": ["customerName", "phone", "systemType", "location", "priceEstimate", "status"]
    },
    "SolarRequest": {
      "title": "SolarRequest",
      "description": "Complete solar system calculation requests submitted by customers with unique IDs and engineering parameters.",
      "type": "object",
      "properties": {
        "requestId": { "type": "string", "description": "Unique formatted request identifier, e.g., ENJ-20260831-0001" },
        "customerId": { "type": "string", "description": "UID of the registered customer or null for guests" },
        "customerName": { "type": "string", "description": "Full name of the customer" },
        "customerPhone": { "type": "string", "description": "Egyptian mobile phone number" },
        "governorate": { "type": "string", "description": "Customer governorate or city" },
        "location": { "type": "string", "description": "Location description or address" },
        "systemType": { "type": "string", "enum": ["on-grid", "off-grid", "hybrid", "pump"], "description": "Architecture of solar system" },
        "tier": { "type": "string", "enum": ["budget", "recommended", "premium"], "description": "Selected component quality tier" },
        "inputs": { "type": "object", "description": "Customer input data including monthly bill, consumption kWh, sun hours, appliances" },
        "calculatedOutputs": { "type": "object", "description": "Engineering calculation outputs including system size, components, costs, savings" },
        "notes": { "type": "string", "description": "Customer extra notes or requirements" },
        "status": { "type": "string", "enum": ["pending", "in_progress", "contacted", "completed", "cancelled"], "description": "Request processing status" },
        "adminNotes": { "type": "string", "description": "Internal notes added by admin team" },
        "supplierContacted": { "type": "string", "description": "Optional specific supplier contacted" },
        "createdAt": { "type": "object", "format": "timestamp", "description": "Server creation timestamp" },
        "updatedAt": { "type": "object", "format": "timestamp", "description": "Last update timestamp" }
      },
      "required": ["requestId", "customerName", "customerPhone", "systemType", "tier", "status"]
    },
    "Customer": {
      "title": "Customer",
      "description": "Authenticated customer accounts created through Phone OTP Authentication.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Authentication UID" },
        "fullName": { "type": "string", "description": "Customer full name in Arabic/English" },
        "phoneNumber": { "type": "string", "description": "Formatted mobile phone number" },
        "normalizedPhoneNumber": { "type": "string", "description": "E.164 normalized phone number (+201xxxxxxxxx)" },
        "email": { "type": "string", "description": "Optional customer email address" },
        "governorate": { "type": "string", "description": "Selected Egyptian governorate" },
        "createdAt": { "type": "object", "format": "timestamp", "description": "Server timestamp of account creation" },
        "updatedAt": { "type": "object", "format": "timestamp", "description": "Server timestamp of profile update" },
        "lastLoginAt": { "type": "object", "format": "timestamp", "description": "Server timestamp of last login" },
        "authProvider": { "type": "string", "enum": ["phone", "google", "email"], "description": "Provider used for authentication" }
      },
      "required": ["uid", "fullName", "phoneNumber", "normalizedPhoneNumber", "authProvider"]
    },
    "Review": {
      "title": "Review",
      "description": "Star ratings and written feedback left by authenticated customers on solar products.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "The UID of the authenticated user who left the review" },
        "userName": { "type": "string", "description": "The name of the user who left the review" },
        "rating": { "type": "number", "description": "Star rating out of 5 (integer 1-5)" },
        "comment": { "type": "string", "description": "Optional written feedback or comment text" },
        "createdAt": { "type": "object", "format": "timestamp", "description": "Server timestamp of review creation" }
      },
      "required": ["userId", "userName", "rating", "createdAt"]
    }
  },
  "firestore": {
    "products/{productId}": {
      "schema": "Product",
      "description": "Collection of solar products in the Egyptian catalog."
    },
    "users/{userId}": {
      "schema": "User",
      "description": "User and supplier profile documents."
    },
    "customers/{uid}": {
      "schema": "Customer",
      "description": "Customer profile documents keyed by authenticated Firebase UID."
    },
    "quotations/{quotationId}": {
      "schema": "Quotation",
      "description": "Calculated quote inquiries submitted by leads."
    },
    "solarRequests/{requestId}": {
      "schema": "SolarRequest",
      "description": "Comprehensive customer solar calculations and system sizing requests."
    },
    "products/{productId}/reviews/{reviewId}": {
      "schema": "Review",
      "description": "Subcollection of star ratings and written reviews for a product."
    }
  }
}
