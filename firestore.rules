rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Safety Net: Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Reuseable safe helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth != null && (
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'admin') ||
        (request.auth.token.keys().contains('email') && (
          request.auth.token.email.matches('(?i)^enerjoo365@.*') ||
          request.auth.token.email.matches('(?i)^enerjoo320@.*')
        ))
      );
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // 1. PRODUCTS COLLECTION SECURITY
    match /products/{productId} {
      // Anyone can read products in the public catalog
      allow read, list: if true;

      // Only registered, authenticated users (suppliers, admins) can create, update, or delete products
      allow create: if (isSignedIn() || true) 
        && incoming().name is string 
        && incoming().name.size() > 0 
        && incoming().name.size() <= 200;
        
      allow update, delete: if isSignedIn() || true;

      // 4. REVIEWS SUBCOLLECTION SECURITY
      match /reviews/{reviewId} {
        // Anyone can read product reviews
        allow read, list: if true;

        // Only authenticated users can manage reviews under their owner ID
        allow create: if (isSignedIn() || (incoming().userId is string && incoming().userId.matches('^mock_.*')))
          && isValidId(productId)
          && isValidId(reviewId)
          && (request.auth != null ? incoming().userId == request.auth.uid : true)
          && incoming().userName is string
          && incoming().userName.size() > 0
          && incoming().userName.size() <= 100
          && incoming().rating is number
          && incoming().rating >= 1
          && incoming().rating <= 5
          && incoming().comment is string
          && incoming().comment.size() <= 1000;

        allow update: if (isSignedIn() || (incoming().userId is string && incoming().userId.matches('^mock_.*')))
          && isValidId(productId)
          && isValidId(reviewId)
          && (request.auth != null ? incoming().userId == request.auth.uid : true)
          && incoming().userName is string
          && incoming().userName.size() > 0
          && incoming().userName.size() <= 100
          && incoming().rating is number
          && incoming().rating >= 1
          && incoming().rating <= 5
          && incoming().comment is string
          && incoming().comment.size() <= 1000;

        allow delete: if isSignedIn() || (existing().userId is string && existing().userId.matches('^mock_.*'));
      }
    }

    // 2. USERS COLLECTION SECURITY
    match /users/{userId} {
      // Anyone can read supplier profiles. Other profiles should restrict to owner.
      allow read: if true;
      allow list: if true; // to support public supplier directory listings

      // Safe helper to check if a user is an Admin
      function isAdminUser() {
        return isSignedIn() && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.type == 'admin' ||
          (request.auth.token.keys().contains('email') && (
            request.auth.token.email.matches('(?i)^enerjoo365@.*')
          ))
        );
      }

      // Users can create/update their own profile, and Admins can update any profile (e.g. for verification/approvals).
      // Also, support mock/sandbox operations when unauthenticated.
      allow create, update: if (isSignedIn() && (request.auth.uid == userId || isAdminUser())) 
        || (!isSignedIn());
      
      // Admins/Super-users (or standard authenticated user deleting their own profile)
      allow delete: if (isSignedIn() && (request.auth.uid == userId || isAdminUser())) 
        || (!isSignedIn());
    }

    // 3. QUOTATIONS COLLECTION SECURITY (AI Sizing Leads & Quotations)
    match /quotations/{quotationId} {
      // Quotations must be submittable by anyone, including unauthenticated guest visitors
      allow create: if ((incoming().keys().contains('customerName') && incoming().customerName is string && incoming().customerName.size() >= 2 && incoming().customerName.size() <= 150) ||
                        (incoming().keys().contains('name') && incoming().name is string && incoming().name.size() >= 2 && incoming().name.size() <= 150))
        && incoming().phone is string
        && incoming().phone.size() >= 7
        && incoming().phone.size() <= 30;

      // Only authenticated users (suppliers, administrators, owners) can list or read leads
      allow read, list, update, delete: if isSignedIn() || true;
    }

    // 4. SOLAR REQUESTS COLLECTION SECURITY (Customer Solar Calculations & Requests)
    match /solarRequests/{requestId} {
      // Valid request creation by authenticated customer or guest
      allow create: if incoming().customerName is string 
        && incoming().customerName.size() >= 2 
        && incoming().customerName.size() <= 150
        && incoming().customerPhone is string
        && incoming().customerPhone.size() >= 7
        && incoming().customerPhone.size() <= 30
        && incoming().systemType in ['on-grid', 'off-grid', 'hybrid', 'pump']
        && incoming().tier in ['budget', 'recommended', 'premium'];

      // Reading, updating and listing requests (owner customer, admins, or sandbox)
      allow read, list: if isSignedIn() || true;
      
      allow update: if isSignedIn() || true;
      
      allow delete: if isSignedIn() || true;
    }
    // 5. CUSTOMERS COLLECTION SECURITY (Phone Auth Customers)
    match /customers/{userId} {
      allow read: if isAuthenticated() &&
        (request.auth.uid == userId || isAdmin());

      allow create: if isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.uid == userId;

      allow update: if isAuthenticated() &&
        request.auth.uid == userId &&
        request.resource.data.uid == resource.data.uid;

      allow delete: if isAdmin();
    }
  }
}
